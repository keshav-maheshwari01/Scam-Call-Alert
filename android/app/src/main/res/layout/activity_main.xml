<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <!-- App title -->
    <TextView
        android:text="🛡 ScamCallAI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="32sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <!-- Subtitle -->
    <TextView
        android:text="Real-time scam call detector"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="#AAAAAA"
        android:layout_marginBottom="40dp"/>

    <!-- Status box -->
    <TextView
        android:id="@+id/statusText"
        android:text="Checking permissions..."
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:padding="20dp"
        android:gravity="center"
        android:layout_marginBottom="30dp"
        android:background="#1E1E1E"/>

    <!-- Info text -->
    <TextView
        android:text="App runs in background automatically.\nNo action needed during calls."
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#888888"
        android:gravity="center"/>



    <Button
        android:id="@+id/testButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🧪 Test Scam Detection"
        android:textSize="18sp"
        android:layout_marginTop="30dp"
        android:backgroundTint="#C62828"/>

</LinearLayout>