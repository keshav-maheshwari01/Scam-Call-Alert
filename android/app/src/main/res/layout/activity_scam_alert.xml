<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/status_scam_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:minHeight="600dp">

        <!-- Siren emoji -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="&#x1F6A8;"
            android:textSize="88sp"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <!-- Title -->
        <TextView
            android:id="@+id/alertTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SCAM CALL DETECTED"
            android:textSize="26sp"
            android:textColor="@color/status_scam"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:gravity="center"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="60dp"
            android:layout_height="3dp"
            android:background="@color/status_scam"
            android:layout_marginBottom="20dp"/>

        <!-- Caller number card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="INCOMING FROM"
                    android:textSize="10sp"
                    android:textColor="@color/text_hint"
                    android:letterSpacing="0.15"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/alertPhoneNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unknown"
                    android:textSize="22sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Warning tips card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#2A0808"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x274C;  DO NOT share your OTP or PIN"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x274C;  DO NOT share Aadhaar / PAN / passport"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x274C;  DO NOT transfer money or gift cards"
                    android:textSize="15sp"
                    android:textColor="@color/white"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="&#x274C;  DO NOT install remote-access apps"
                    android:textSize="15sp"
                    android:textColor="@color/white"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- End call button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/endCallButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="OK - I WILL HANG UP"
            android:textSize="17sp"
            android:textColor="@color/white"
            android:letterSpacing="0.05"
            app:backgroundTint="@color/btn_end_call"
            app:cornerRadius="14dp"
            android:layout_marginBottom="12dp"/>

        <!-- Ignore button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/ignoreButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Ignore Warning"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            app:cornerRadius="14dp"/>

    </LinearLayout>
</ScrollView>
